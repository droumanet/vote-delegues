<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vote — Élection des délégués</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<!-- Drapeau mode écran (projection) injecté par EJS -->
<script>
  window.MODE_ECRAN = <%= typeof modeEcran !== 'undefined' && modeEcran ? 'true' : 'false' %>;
</script>

<!-- ============ 1. ÉMARGEMENT ============ -->
<div id="ecranIdentite" class="container py-5 d-none" style="max-width:460px">
  <div class="card shadow-sm">
    <div class="card-body p-4">
      <h4 class="mb-1">🎓 Émargement</h4>
      <p class="text-muted small mb-4">
        Votre prénom sert uniquement à établir la <strong>liste des présents</strong>.
        Il n'est <strong>jamais associé</strong> à votre bulletin.
      </p>
      <div class="mb-3">
        <label class="form-label">Votre prénom (et initiale du nom si homonyme)</label>
        <input type="text" id="prenomInput" class="form-control form-control-lg"
               placeholder="Ex. : Camille D." maxlength="40" autocomplete="off">
      </div>
      <button id="btnRejoindre" class="btn btn-success btn-lg w-100">Signer la feuille de présence</button>
      <div id="erreurIdentite" class="alert alert-danger mt-3 d-none small"></div>
    </div>
  </div>
</div>

<!-- ============ 2. ESPACE DE VOTE ============ -->
<div id="ecranVote" class="container py-4 d-none">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h3 class="mb-0">🗳️ Élection des délégués</h3>
      <small class="text-muted">
        Connecté·e en tant que <strong id="monPrenom"></strong>
      </small>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <span class="badge bg-secondary fs-6">Tour <span id="numTourEtu">1</span></span>
      <span id="badgeStatutEtu" class="badge fs-6">—</span>
    </div>
  </div>

  <!-- Scrutin fermé -->
  <div id="blocAttente" class="card shadow-sm text-center d-none">
    <div class="card-body py-5">
      <div class="spinner-border text-secondary mb-3" role="status"></div>
      <h5>Le scrutin n'est pas encore ouvert</h5>
      <p class="text-muted mb-0">Patientez, le professeur va ouvrir le vote.</p>
    </div>
  </div>

  <!-- Bulletin de vote -->
  <div id="blocBulletin" class="d-none">
    <div class="alert alert-info small">
      🔒 <strong>Bulletin secret.</strong> Votre choix est déposé dans une urne numérique
      à une position aléatoire, sans aucun lien avec votre identité.
      Seul l'émargement (« a voté ») est enregistré.
    </div>

    <h5 class="mb-3">Choisissez un binôme</h5>
    <div id="listeChoix" class="row g-3 mb-4"></div>

    <h6 class="text-muted mb-2">Autres bulletins</h6>
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="card choix-card h-100" data-choix="blanc">
          <div class="card-body text-center">
            <div class="fs-2">⬜</div>
            <div class="fw-semibold">Vote blanc</div>
            <small class="text-muted">Bulletin vierge : compté séparément, hors suffrages exprimés.</small>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card choix-card h-100" data-choix="nul">
          <div class="card-body text-center">
            <div class="fs-2">❌</div>
            <div class="fw-semibold">Vote nul</div>
            <small class="text-muted">Bulletin raturé ou non conforme : hors suffrages exprimés.</small>
          </div>
        </div>
      </div>
    </div>

    <div class="d-grid">
      <button id="btnValiderVote" class="btn btn-primary btn-lg" disabled>
        Glisser mon bulletin dans l'urne
      </button>
    </div>
    <div id="erreurVote" class="alert alert-danger mt-3 d-none small"></div>
  </div>

  <!-- Confirmation de vote -->
  <div id="blocAVote" class="card shadow-sm text-center d-none border-success">
    <div class="card-body py-5">
      <div class="display-1">✅</div>
      <h4 class="text-success">Vous avez voté</h4>
      <p class="text-muted mb-0">
        Merci. Votre bulletin est anonyme et définitif pour ce tour.<br>
        Les résultats seront affichés après la clôture du scrutin.
      </p>
    </div>
  </div>

  <!-- Compteur de participation -->
  <div id="blocParticipation" class="card shadow-sm mt-4">
    <div class="card-body">
      <div class="d-flex justify-content-between small text-muted mb-1">
        <span>Participation</span>
        <span><strong id="nbVotants">0</strong> votant(s) / <strong id="nbPresents">0</strong> présent(s)</span>
      </div>
      <div class="progress" style="height:10px">
        <div id="barreParticipation" class="progress-bar bg-success" style="width:0%"></div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 3. RÉSULTATS ============ -->
<div id="ecranResultats" class="container py-4 d-none">
  <div class="text-center mb-4">
    <h2 class="fw-bold">📊 Résultats du scrutin</h2>
    <p class="text-muted mb-0">Tour <span id="resTour">1</span> — dépouillement public</p>
  </div>

  <div id="verdict" class="alert text-center fs-5"></div>

  <div id="blocElu" class="card border-success shadow-sm mb-4 d-none">
    <div class="card-body text-center py-4">
      <div class="display-4">🏆</div>
      <h4 class="text-success mb-3">Binôme élu</h4>
      <div class="fs-4 fw-bold" id="eluTitulaire"></div>
      <div class="text-muted">Délégué·e titulaire</div>
      <hr class="w-50 mx-auto">
      <div class="fs-5 fw-semibold" id="eluSuppleant"></div>
      <div class="text-muted">Délégué·e suppléant·e</div>
    </div>
  </div>

  <!-- Chiffres clés -->
  <div class="row g-3 mb-4" id="chiffresCles"></div>

  <!-- Détail par binôme -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Résultats par binôme</div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Binôme (titulaire / suppléant)</th>
            <th class="text-end" style="width:110px">Voix</th>
            <th style="width:220px">% exprimés</th>
          </tr>
        </thead>
        <tbody id="tableResultats"></tbody>
      </table>
    </div>
  </div>

  <!-- Liste des présents -->
  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold">👥 Liste des présents</span>
      <span class="badge bg-secondary" id="resNbPresents">0</span>
    </div>
    <div class="card-body">
      <p class="text-muted small">
        ⚠️ Cette liste atteste uniquement de la <strong>présence</strong>.
        Elle n'est en aucune façon reliée au contenu des bulletins.
      </p>
      <div id="listePresents" class="d-flex flex-wrap gap-2"></div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/etudiant.js"></script>
</body>
</html>
