<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Espace professeur — Élection des délégués</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<!-- Connexion -->
<div id="ecranAuth" class="container py-5" style="max-width:420px">
  <div class="card shadow-sm">
    <div class="card-body">
      <h4 class="mb-3">🔐 Espace professeur</h4>
      <div class="mb-3">
        <label class="form-label">Code d'accès</label>
        <input type="password" id="codeProf" class="form-control" placeholder="Code">
      </div>
      <button id="btnAuth" class="btn btn-primary w-100">Se connecter</button>
      <div id="authErreur" class="alert alert-danger mt-3 d-none"></div>
    </div>
  </div>
</div>

<!-- Tableau de bord -->
<div id="ecranProf" class="container-fluid py-4 d-none">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h3 class="mb-0">👨‍🏫 Pilotage du scrutin</h3>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-secondary fs-6">Tour <span id="numTour">1</span></span>
      <span id="badgeStatut" class="badge fs-6">—</span>
    </div>
  </div>

  <div class="row g-4">
    <!-- Colonne gauche -->
    <div class="col-lg-5">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">1. Binômes candidats</div>
        <div class="card-body">
          <p class="small text-muted">Un binôme par ligne : titulaire et suppléant.</p>
          <div id="lignesBinomes"></div>
          <div class="d-flex gap-2 mt-3">
            <button id="btnAjouterLigne" class="btn btn-outline-secondary btn-sm">+ Ligne</button>
            <button id="btnEnregistrer" class="btn btn-primary btn-sm">💾 Enregistrer les binômes</button>
          </div>
          <div id="msgBinomes" class="small mt-2"></div>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">2. Déroulement</div>
        <div class="card-body d-grid gap-2">
          <button id="btnOuvrir" class="btn btn-success">🟢 Ouvrir le vote</button>
          <button id="btnFermer" class="btn btn-danger" disabled>🔴 Fermer le vote et dépouiller</button>
          <button id="btnSecondTour" class="btn btn-warning d-none">↪️ Organiser le second tour</button>
          <hr class="my-2">
          <button id="btnResetTour" class="btn btn-outline-secondary btn-sm">♻️ Réinitialiser le scrutin (garder les listes)</button>
          <button id="btnResetTout" class="btn btn-outline-danger btn-sm">🗑️ Tout effacer</button>
        </div>
      </div>
    </div>

    <!-- Colonne droite -->
    <div class="col-lg-7">
      <div class="row g-3 mb-4">
        <div class="col-4">
          <div class="card text-center shadow-sm">
            <div class="card-body py-3">
              <div class="display-6 fw-bold text-primary" id="statPresents">0</div>
              <div class="small text-muted">Présents</div>
            </div>
          </div>
        </div>
        <div class="col-4">
          <div class="card text-center shadow
