<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Élection des délégués</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
  <div class="container py-5">
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold">🗳️ Élection des délégués</h1>
      <p class="lead text-muted">Scrutin binominal majoritaire à deux tours</p>
    </div>
    <div class="row justify-content-center g-4">
      <div class="col-md-5">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center">
            <div class="fs-1">👨‍🏫</div>
            <h5 class="card-title">Professeur</h5>
            <p class="card-text text-muted small">Saisie des binômes, ouverture et clôture du scrutin.</p>
            <a href="/professeur" class="btn btn-primary">Espace professeur</a>
          </div>
        </div>
      </div>
      <div class="col-md-5">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center">
            <div class="fs-1">🎓</div>
            <h5 class="card-title">Étudiant</h5>
            <p class="card-text text-muted small">Émargement et vote à bulletin secret.</p>
            <a href="/etudiant" class="btn btn-success">Espace étudiant</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
